{
  "name": "nexos-launcher",
  "productName": "Nexos Launcher",
  "version": "0.2.0",
  "description": "Launcher de Nexos MC: instala y actualiza el modpack, cuentas premium y no premium, skins.",
  "main": "dist/main/main.js",
  "private": true,
  "author": "Nexos MC",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "start": "npm run build && node scripts/electron.mjs",
    "captura": "npm run build && node scripts/electron.mjs --captura=captura.png",
    "postinstall": "node scripts/fix-deps.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "publicar": "npm run build && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.1.0",
    "electron-builder": "26.17.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "electron-updater": "6.8.10",
    "undici": "8.12.3"
  },
  "overrides": {
    "undici": "$undici"
  },
  "build": {
    "appId": "com.nexosmc.launcher",
    "productName": "Nexos Launcher",
    "copyright": "Nexos MC",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Nexos-Launcher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Nexos Launcher",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ssebatiaan",
        "repo": "Nexos-Launcher",
        "releaseType": "release"
      }
    ]
  }
}
